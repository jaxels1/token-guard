{
  "token-guard": {
    "PreToolUse": [
      {
        "matcher": "read_file|view_file|run_command|grep_search|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook_entry.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
